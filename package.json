{
  "name": "decktector",
  "version": "1.3.0",
  "description": "Real-time visualizer for Pioneer Pro DJ Link decks (CDJ/XDJ): waveforms, metadata and player state",
  "type": "module",
  "author": "Virgile Pornet",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "postinstall": "node scripts/prepare-openssl.mjs",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "dev": "node scripts/with-openssl.mjs tauri dev",
    "dev:sim": "node scripts/with-openssl.mjs cross-env DECKTECTOR_SIM=1 tauri dev",
    "dev:sim4": "node scripts/with-openssl.mjs cross-env DECKTECTOR_SIM=1 DECKTECTOR_SIM_DECKS=4 tauri dev",
    "dev:sim:recorded": "node scripts/with-openssl.mjs cross-env DECKTECTOR_SIM=1 DECKTECTOR_SIM_DECKS=4 DECKTECTOR_SIM_TRACKS=../crates/decktector-core/fixtures/sim-tracks.json tauri dev",
    "build": "npm run typecheck && npm run test && node scripts/with-openssl.mjs tauri build",
    "tauri": "node scripts/with-openssl.mjs tauri",
    "branding": "node scripts/branding/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "node scripts/with-openssl.mjs cargo test --workspace",
    "lint:rust": "node scripts/with-openssl.mjs cargo clippy --workspace --all-targets -- -D warnings"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "opentype.js": "^2.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
