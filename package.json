{
  "name": "decktective",
  "version": "1.0.0",
  "description": "Real-time visualizer for Pioneer Pro DJ Link decks (CDJ/XDJ): waveforms, metadata and player state",
  "type": "module",
  "author": "Virgile Pornet",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "dev": "tauri dev",
    "dev:sim": "cross-env DECKTECTIVE_SIM=1 tauri dev",
    "dev:sim4": "cross-env DECKTECTIVE_SIM=1 DECKTECTIVE_SIM_DECKS=4 tauri dev",
    "dev:sim:recorded": "cross-env DECKTECTIVE_SIM=1 DECKTECTIVE_SIM_DECKS=4 DECKTECTIVE_SIM_TRACKS=crates/decktective-core/fixtures/sim-tracks.json tauri dev",
    "build": "npm run typecheck && npm run test && tauri build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --workspace",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
